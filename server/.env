# ====================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO HỆ THỐNG CHAT DDD (WampServer MySQL)
# ====================================================================

# Cổng khởi chạy Server Backend (Hỗ trợ 0.0.0.0 để máy khác trong mạng LAN truy cập)
PORT=5000
HOST=0.0.0.0

# Cấu hình kết nối MySQL trên WampServer (Mặc định: host=127.0.0.1, user=root, pass="")
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ddd_chat_db

# Bảo mật JWT
JWT_SECRET=super_secret_ddd_chat_jwt_key_2026_very_secure_99_percent
JWT_EXPIRES_IN=7d

# Cấu hình CORS - Cho phép máy nội bộ và web kết nối
CLIENT_URL=*

# Đường dẫn thư mục lưu file upload
UPLOAD_DIR=uploads
